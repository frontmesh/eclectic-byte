---
import { getCollection } from "astro:content";
import PostList from "../../components/PostList.astro";
import PageLayout from "../../layouts/PageLayout.astro";
import { buildAbsoluteUrl, siteConfig } from "../../site-config";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
	(a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf()
);
const description =
	"Posts from Eclectic Byte on focused software, product decisions, and the tools I build.";
const blogUrl = buildAbsoluteUrl("/blog/");
const structuredData = blogUrl
	? [
			{
				"@context": "https://schema.org",
				"@type": "Blog",
				name: `${siteConfig.siteName} Blog`,
				description,
				url: blogUrl,
				blogPost: posts.map((post) => ({
					"@type": "BlogPosting",
					headline: post.data.title,
					url: buildAbsoluteUrl(`/blog/${post.id}/`),
					datePublished: post.data.publishedAt.toISOString()
				}))
			}
		]
	: [];
---

<PageLayout
	title={`Blog — ${siteConfig.siteName}`}
	description={description}
	pathname="/blog/"
	eyebrow="Blog"
	heading="From the blog."
	intro={description}
	structuredData={structuredData}
	animateHeading
>
	{
		posts.length > 0 ? (
			<PostList posts={posts} />
		) : (
			<p class="empty-state">No posts have been published yet.</p>
		)
	}
</PageLayout>

<style>
	.empty-state {
		color: var(--color-muted);
		line-height: 1.7;
	}
</style>
