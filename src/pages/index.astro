---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BlurInWords from "../components/BlurInWords.astro";
import PostList from "../components/PostList.astro";
import {
	buildAbsoluteUrl,
	habitoroConfig,
	projects,
	siteConfig,
	vatLoomConfig,
	videoCompressorConfig
} from "../site-config";

const pageTitle = `${siteConfig.siteName} — ${siteConfig.siteTagline}`;
const pageDescription = siteConfig.siteDescription;
const websiteUrl = buildAbsoluteUrl("/");
const isVatLoomLive = vatLoomConfig.status === "live";
const vatLoomStatusLabel = isVatLoomLive ? "Available now" : "In Shopify review";
const vatLoomPanelExternal = isVatLoomLive && Boolean(vatLoomConfig.listingUrl);
let vatLoomPanelHref = `${vatLoomConfig.path}#launch-list`;
let vatLoomPanelLabel = "Get the launch email";

if (vatLoomPanelExternal) {
	vatLoomPanelHref = vatLoomConfig.listingUrl;
	vatLoomPanelLabel = "Start free trial";
}
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3);
const structuredData = websiteUrl
	? [
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: siteConfig.siteName,
				url: websiteUrl,
				description: siteConfig.siteDescription
			},
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: vatLoomConfig.productName,
				applicationCategory: "BusinessApplication",
				operatingSystem: "Shopify Admin",
				description: vatLoomConfig.description,
				url: buildAbsoluteUrl(vatLoomConfig.path)
			},
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: habitoroConfig.productName,
				applicationCategory: "LifestyleApplication",
				operatingSystem: "iOS",
				description: habitoroConfig.heroDescription,
				url: habitoroConfig.websiteUrl,
				installUrl: habitoroConfig.appStoreUrl
			},
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: videoCompressorConfig.productName,
				applicationCategory: "MultimediaApplication",
				operatingSystem: "iOS",
				description: videoCompressorConfig.heroDescription,
				url: websiteUrl
			}
		]
	: [];
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	pathname="/"
	structuredData={structuredData}
>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Independent software studio</p>
			<h1><BlurInWords text={siteConfig.siteTagline} /></h1>
			<p class="hero-text">
				Eclectic Byte builds focused tools for commerce and iOS. VatLoom is the current
				project.
			</p>
			<div class="hero-actions">
				<a class="button button-primary" href={vatLoomConfig.path}>See VatLoom</a>
				<a class="button button-secondary" href="#projects">See all projects</a>
			</div>
		</div>
		<aside class="hero-panel" aria-labelledby="current-product-title">
			<div class="panel-chip">Currently</div>
			<h2 id="current-product-title">{vatLoomConfig.productName}</h2>
			<p class="panel-status">{vatLoomStatusLabel}</p>
			<p>{vatLoomConfig.description}</p>
			<a
				class="panel-link"
				href={vatLoomPanelHref}
				target={vatLoomPanelExternal ? "_blank" : undefined}
				rel={vatLoomPanelExternal ? "noopener noreferrer" : undefined}
			>
				{vatLoomPanelLabel} <span aria-hidden="true">→</span>
			</a>
		</aside>
	</section>

	<section class="section projects-section" id="projects">
		<div class="section-heading projects-heading">
			<div>
				<p class="eyebrow">Projects</p>
				<h2>Different problems. Same standard.</h2>
			</div>
			<p class="section-intro">
				A small portfolio of products and client work. Each starts with a narrow problem and stops
				when the problem is solved.
			</p>
		</div>
		<div class="projects-grid">
			{
				projects.map((project, index) => {
					const { link } = project;
					return (
						<article class:list={["project-card", { "project-card-featured": project.featured }]}>
							<div class="project-card-topline">
								<span class="project-mark" aria-hidden="true">{project.mark}</span>
								<span class="project-number">{String(index + 1).padStart(2, "0")}</span>
							</div>
							<div class="project-copy">
								<p class="project-category">{project.category}</p>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
							</div>
							<div class="project-card-footer">
								<ul class="project-tags" aria-label={`${project.name} technologies`}>
									{project.tags.map((tag) => <li>{tag}</li>)}
								</ul>
								<div class="project-action">
									<span class="project-status">{project.availability}</span>
									{link && (
										<a
											class="project-link"
											href={link.href}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noopener noreferrer" : undefined}
										>
											{link.label}
											<span aria-hidden="true">{link.external ? " ↗" : " →"}</span>
										</a>
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	<section class="founder-section" aria-labelledby="founder-title">
		<div class="founder-copy">
			<h2 id="founder-title">I'm Vladimir. I build and run these tools.</h2>
			<p>
				I start with a narrow problem, keep the scope small, and ship when it does one job
				properly. If you're working on EU OSS reporting or a Shopify integration, email me.
			</p>
		</div>
		<a class="button button-secondary" href={`mailto:${siteConfig.founder.email}`}>Email me</a>
	</section>

	{
		blogPosts.length > 0 && (
			<section class="section" id="blog">
				<div class="section-heading blog-section-heading">
					<div>
						<p class="eyebrow">Blog</p>
						<h2>From the blog.</h2>
					</div>
					<a class="section-link" href="/blog/">
						All posts <span aria-hidden="true">→</span>
					</a>
				</div>
				<PostList posts={blogPosts} />
			</section>
		)
	}
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.85fr);
		gap: var(--space-8);
		padding: var(--space-8) 0 var(--space-16);
		align-items: center;
	}

	.hero-copy h1,
	.section-heading h2,
	.project-card h3,
	.hero-panel h2,
	.founder-copy h2 {
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.hero-copy h1 {
		font-size: clamp(3.25rem, 8vw, 6.5rem);
		max-width: 18ch;
	}

	.hero-text {
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--color-muted);
		max-width: 38rem;
		margin: var(--space-6) 0 0;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-top: var(--space-8);
	}

	.project-link,
	.section-link,
	.panel-link {
		transition:
			transform var(--transition-fast),
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.project-link:hover,
	.section-link:hover,
	.panel-link:hover {
		transform: translateY(-2px);
	}

	.hero-panel {
		padding: clamp(1.5rem, 2vw, 2rem);
		background: var(--color-panel);
		backdrop-filter: blur(14px);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-soft);
	}

	.panel-chip {
		display: inline-flex;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-deep);
		background: var(--color-accent-soft);
	}

	.hero-panel h2 {
		font-size: clamp(2rem, 3vw, 3rem);
		margin-top: var(--space-4);
	}

	.hero-panel p {
		color: var(--color-muted);
		line-height: 1.7;
	}

	.hero-panel .panel-status {
		margin: var(--space-2) 0 0;
		color: var(--color-accent-deep);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.panel-link {
		display: inline-flex;
		align-items: center;
		gap: var(--space-2);
		margin-top: var(--space-6);
		color: var(--color-ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.section {
		padding: 0 0 var(--space-16);
	}

	.section-heading {
		margin-bottom: var(--space-6);
	}

	.section-heading h2 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		max-width: 12ch;
	}

	.projects-section {
		padding-top: var(--space-8);
	}

	.projects-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
		gap: var(--space-8);
		align-items: end;
	}

	.section-intro {
		margin: 0 0 var(--space-2);
		color: var(--color-muted);
		line-height: 1.7;
		max-width: 34rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
	}

	.project-card {
		display: flex;
		min-height: var(--project-card-min-height);
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		padding: var(--space-8);
		background: var(--color-card-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-soft);
	}

	.project-card-featured {
		background:
			linear-gradient(145deg, var(--color-featured-start), var(--color-featured-end));
		color: var(--color-on-dark);
	}

	.project-card-topline,
	.project-card-footer {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.project-mark {
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border-radius: var(--radius-m);
		background: var(--color-accent-soft);
		color: var(--color-accent-deep);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.project-card-featured .project-mark {
		background: var(--color-featured-mark);
		color: var(--color-on-dark);
	}

	.project-number,
	.project-category {
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.project-number {
		color: var(--color-muted);
	}

	.project-category {
		margin: 0 0 var(--space-4);
		color: var(--color-accent-deep);
	}

	.project-card-featured .project-number,
	.project-card-featured .project-category,
	.project-card-featured .project-copy p {
		color: var(--color-featured-muted);
	}

	.project-card h3 {
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		margin-bottom: var(--space-4);
	}

	.project-copy > p:last-child {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.7;
	}

	.project-tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-tags li {
		padding: 0.35rem 0.65rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: 0.76rem;
		color: var(--color-muted);
	}

	.project-card-featured .project-tags li {
		color: var(--color-featured-muted);
	}

	.project-link,
	.section-link {
		flex: 0 0 auto;
		color: var(--color-ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.project-card-featured .project-link {
		color: var(--color-on-dark);
	}

	.project-status {
		flex: 0 0 auto;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.project-card-featured .project-status {
		border-color: var(--color-featured-border);
		color: var(--color-featured-muted);
	}

	.project-action {
		display: flex;
		flex: 0 0 auto;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-2);
	}

	.founder-section {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-8);
		flex-wrap: wrap;
		margin-bottom: var(--space-16);
		padding: var(--space-8);
		background: var(--color-card-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-soft);
	}

	.founder-copy {
		flex: 1;
		min-width: 0;
	}

	.founder-copy h2 {
		max-width: 18ch;
		font-size: clamp(2rem, 4vw, 3.5rem);
	}

	.founder-copy p:last-child {
		max-width: 44rem;
		margin: var(--space-4) 0 0;
		color: var(--color-muted);
		line-height: 1.7;
	}

	.blog-section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	@media (max-width: 920px) {
		.hero,
		.projects-heading,
		.projects-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.hero-copy h1,
		.section-heading h2 {
			max-width: none;
		}

		.project-card-footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.project-action {
			align-items: flex-start;
		}

		.founder-section {
			align-items: flex-start;
			flex-direction: column;
		}
	}
</style>
