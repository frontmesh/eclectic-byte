---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostList from "../components/PostList.astro";
import {
	buildAbsoluteUrl,
	habitoroConfig,
	legalLinks,
	projects,
	siteConfig,
	videoCompressorConfig
} from "../site-config";

const pageTitle = siteConfig.siteName;
const pageDescription = siteConfig.siteDescription;
const websiteUrl = buildAbsoluteUrl("/");
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft))
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 3);
const structuredData = websiteUrl
	? [
			{
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: siteConfig.siteName,
				url: websiteUrl,
				description: siteConfig.siteDescription
			},
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: habitoroConfig.productName,
				applicationCategory: "LifestyleApplication",
				operatingSystem: "iOS",
				description: habitoroConfig.heroDescription,
				url: habitoroConfig.websiteUrl,
				installUrl: habitoroConfig.appStoreUrl
			},
			{
				"@context": "https://schema.org",
				"@type": "SoftwareApplication",
				name: videoCompressorConfig.productName,
				applicationCategory: "MultimediaApplication",
				operatingSystem: "Unspecified",
				description: videoCompressorConfig.heroDescription,
				url: websiteUrl
			}
		]
	: [];
---

<BaseLayout
	title={pageTitle}
	description={pageDescription}
	pathname="/"
	structuredData={structuredData}
	footerLinks={legalLinks.map(({ href, label }) => ({ href, label }))}
>
	<section class="hero">
		<div class="hero-copy">
			<p class="eyebrow">Small software studio</p>
			<h1>Eclectic Byte ships focused tools without the usual surface noise.</h1>
			<p class="hero-text">
				A small collection of mobile products and commerce tools—built to do one thing well and
				stay out of the way.
			</p>
			<div class="hero-actions">
				<a class="button button-primary" href="#projects">Explore projects</a>
				<a class="button button-secondary" href="/blog/">Read the blog</a>
			</div>
		</div>
		<aside class="hero-panel" aria-labelledby="featured-product-title">
			<div class="panel-chip">Featured product</div>
			<h2 id="featured-product-title">{habitoroConfig.productName}</h2>
			<p>{habitoroConfig.heroDescription}</p>
		</aside>
	</section>

	<section class="section projects-section" id="projects">
		<div class="section-heading projects-heading">
			<div>
				<p class="eyebrow">Selected projects</p>
				<h2>Useful software, built with a point of view.</h2>
			</div>
			<p class="section-intro">
				From habit tracking to Shopify operations, each project starts with a narrow problem and a
				preference for clear, durable solutions.
			</p>
		</div>
		<div class="projects-grid">
			{
				projects.map((project, index) => {
					const { link } = project;
					return (
						<article class:list={["project-card", { "project-card-featured": index === 0 }]}>
							<div class="project-card-topline">
								<span class="project-mark" aria-hidden="true">{project.mark}</span>
								<span class="project-number">{String(index + 1).padStart(2, "0")}</span>
							</div>
							<div class="project-copy">
								<p class="project-category">{project.category}</p>
								<h3>{project.name}</h3>
								<p>{project.description}</p>
							</div>
							<div class="project-card-footer">
								<ul class="project-tags" aria-label={`${project.name} technologies`}>
									{project.tags.map((tag) => <li>{tag}</li>)}
								</ul>
								<div class="project-action">
									<span class="project-status">{project.availability}</span>
									{link && (
										<a
											class="project-link"
											href={link.href}
											target={link.external ? "_blank" : undefined}
											rel={link.external ? "noopener noreferrer" : undefined}
										>
											{link.label}
											<span aria-hidden="true">{link.external ? " ↗" : " →"}</span>
										</a>
									)}
								</div>
							</div>
						</article>
					);
				})
			}
		</div>
	</section>

	{
		blogPosts.length > 0 && (
			<section class="section" id="blog">
				<div class="section-heading blog-section-heading">
					<div>
						<p class="eyebrow">Blog</p>
						<h2>Notes from the studio.</h2>
					</div>
					<a class="section-link" href="/blog/">
						All posts <span aria-hidden="true">→</span>
					</a>
				</div>
				<PostList posts={blogPosts} />
			</section>
		)
	}

	<section class="section" id="legal">
		<div class="section-heading">
			<p class="eyebrow">Legal</p>
			<h2>Video Compressor legal resources</h2>
		</div>
		<div class="two-column-grid">
			{
				legalLinks.map((link) => (
					<a class="legal-card" href={link.href}>
						<h3>{link.label}</h3>
						<p>{link.description}</p>
					</a>
				))
			}
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.35fr) minmax(18rem, 0.85fr);
		gap: var(--space-8);
		padding: var(--space-8) 0 var(--space-16);
		align-items: center;
	}

	.hero-copy h1,
	.section-heading h2,
	.project-card h3,
	.legal-card h3,
	.hero-panel h2 {
		font-family: "Instrument Serif", serif;
		font-weight: 400;
		line-height: 0.95;
		letter-spacing: -0.04em;
		margin: 0;
	}

	.hero-copy h1 {
		font-size: clamp(3.5rem, 9vw, 7rem);
		max-width: 11ch;
	}

	.hero-text {
		font-size: 1.15rem;
		line-height: 1.75;
		color: var(--color-muted);
		max-width: 38rem;
		margin: var(--space-6) 0 0;
	}

	.hero-actions {
		display: flex;
		gap: var(--space-4);
		flex-wrap: wrap;
		margin-top: var(--space-8);
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		text-decoration: none;
		border-radius: 999px;
		padding: 0.9rem 1.25rem;
		font-weight: 700;
		letter-spacing: 0.02em;
	}

	.button-primary {
		background: var(--color-ink);
		color: white;
	}

	.button-secondary {
		background: var(--color-button-secondary);
		border: 1px solid var(--color-border);
	}

	.button,
	.project-link,
	.section-link {
		transition:
			transform var(--transition-fast),
			background-color var(--transition-fast),
			color var(--transition-fast);
	}

	.button:hover,
	.project-link:hover,
	.section-link:hover {
		transform: translateY(-2px);
	}

	.hero-panel,
	.legal-card {
		background: var(--color-panel);
		backdrop-filter: blur(14px);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-soft);
	}

	.hero-panel {
		padding: clamp(1.5rem, 2vw, 2rem);
	}

	.panel-chip {
		display: inline-flex;
		padding: 0.35rem 0.7rem;
		border-radius: 999px;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
		color: var(--color-accent-deep);
		background: var(--color-accent-soft);
	}

	.hero-panel h2 {
		font-size: clamp(2rem, 3vw, 3rem);
		margin-top: var(--space-4);
	}

	.hero-panel p,
	.legal-card p {
		color: var(--color-muted);
		line-height: 1.7;
	}

	.section {
		padding: 0 0 var(--space-16);
	}

	.section-heading {
		margin-bottom: var(--space-6);
	}

	.section-heading h2 {
		font-size: clamp(2.5rem, 5vw, 4rem);
		max-width: 12ch;
	}

	.projects-section {
		padding-top: var(--space-8);
	}

	.projects-heading {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(18rem, 0.72fr);
		gap: var(--space-8);
		align-items: end;
	}

	.section-intro {
		margin: 0 0 var(--space-2);
		color: var(--color-muted);
		line-height: 1.7;
		max-width: 34rem;
	}

	.projects-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
	}

	.project-card {
		display: flex;
		min-height: var(--project-card-min-height);
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-8);
		padding: var(--space-8);
		background: var(--color-card-panel);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-l);
		box-shadow: var(--shadow-soft);
	}

	.project-card-featured {
		background:
			linear-gradient(145deg, var(--color-featured-start), var(--color-featured-end));
		color: white;
	}

	.project-card-topline,
	.project-card-footer {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: var(--space-4);
	}

	.project-mark {
		display: grid;
		width: 3.25rem;
		height: 3.25rem;
		place-items: center;
		border-radius: var(--radius-m);
		background: var(--color-accent-soft);
		color: var(--color-accent-deep);
		font-weight: 700;
		letter-spacing: 0.06em;
	}

	.project-card-featured .project-mark {
		background: var(--color-featured-mark);
		color: white;
	}

	.project-number,
	.project-category {
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.project-number {
		color: var(--color-muted);
	}

	.project-category {
		margin: 0 0 var(--space-4);
		color: var(--color-accent-deep);
	}

	.project-card-featured .project-number,
	.project-card-featured .project-category,
	.project-card-featured .project-copy p {
		color: var(--color-featured-muted);
	}

	.project-card h3 {
		font-size: clamp(2.25rem, 4vw, 3.5rem);
		margin-bottom: var(--space-4);
	}

	.project-copy > p:last-child {
		margin: 0;
		color: var(--color-muted);
		line-height: 1.7;
	}

	.project-tags {
		display: flex;
		gap: var(--space-2);
		flex-wrap: wrap;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.project-tags li {
		padding: 0.35rem 0.65rem;
		border: 1px solid currentColor;
		border-radius: 999px;
		font-size: 0.76rem;
		color: var(--color-muted);
	}

	.project-card-featured .project-tags li {
		color: var(--color-featured-muted);
	}

	.project-link,
	.section-link {
		flex: 0 0 auto;
		color: var(--color-ink);
		font-size: 0.9rem;
		font-weight: 700;
		text-decoration: none;
	}

	.project-card-featured .project-link {
		color: white;
	}

	.project-status {
		flex: 0 0 auto;
		padding: 0.35rem 0.7rem;
		border: 1px solid var(--color-border);
		border-radius: 999px;
		color: var(--color-muted);
		font-size: 0.76rem;
		font-weight: 700;
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	.project-card-featured .project-status {
		border-color: var(--color-featured-border);
		color: var(--color-featured-muted);
	}

	.project-action {
		display: flex;
		flex: 0 0 auto;
		flex-direction: column;
		align-items: flex-end;
		gap: var(--space-2);
	}

	.blog-section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: var(--space-6);
		flex-wrap: wrap;
	}

	.two-column-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: var(--space-6);
	}

	.legal-card {
		padding: var(--space-8);
		text-decoration: none;
	}

	.legal-card h3 {
		font-size: clamp(1.8rem, 3vw, 2.5rem);
		margin-bottom: var(--space-4);
	}

	@media (max-width: 920px) {
		.hero,
		.projects-heading,
		.projects-grid,
		.two-column-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 640px) {
		.hero-copy h1,
		.section-heading h2 {
			max-width: none;
		}

		.project-card-footer {
			align-items: flex-start;
			flex-direction: column;
		}

		.project-action {
			align-items: flex-start;
		}
	}
</style>
