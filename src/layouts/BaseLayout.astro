---
import { buildAbsoluteUrl, habitoroConfig, siteConfig, vatLoomConfig } from "../site-config";
import BackgroundScene from "../components/BackgroundScene.astro";

interface Props {
	title: string;
	description: string;
	pathname?: string;
	ogType?: "website" | "article";
	noindex?: boolean;
	structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
	title,
	description,
	pathname = Astro.url.pathname,
	ogType = "website",
	noindex = !siteConfig.siteUrl,
	structuredData = []
} = Astro.props;

const canonicalUrl = buildAbsoluteUrl(pathname);
const socialImageUrl = buildAbsoluteUrl(siteConfig.socialCardPath);
const robotsContent = noindex ? "noindex, nofollow" : "index, follow";
const sitemapHref = siteConfig.siteUrl ? "/sitemap-index.xml" : undefined;
const structuredDataEntries = Array.isArray(structuredData) ? structuredData : [structuredData];
const organizationSchema = canonicalUrl
	? {
			"@context": "https://schema.org",
			"@type": siteConfig.companyType,
			name: siteConfig.siteName,
			description: siteConfig.siteDescription,
			url: siteConfig.siteUrl,
			logo: buildAbsoluteUrl(siteConfig.brandMarkPath),
			email: siteConfig.founder.email,
			founder: {
				"@type": "Person",
				name: siteConfig.founder.name
			}
		}
	: undefined;

const schemaGraph = [organizationSchema, ...structuredDataEntries].filter(Boolean);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="robots" content={robotsContent} />
		<meta property="og:site_name" content={siteConfig.siteName} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:locale" content={siteConfig.locale} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<link rel="icon" type={siteConfig.brandMarkType} href={siteConfig.brandMarkPath} sizes="any" />
		{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
		{sitemapHref && <link rel="sitemap" href={sitemapHref} />}
		{canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
		{socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
		{socialImageUrl && <meta name="twitter:image" content={socialImageUrl} />}
		<title>{title}</title>
		{
			schemaGraph.length > 0 && (
				<script
					type="application/ld+json"
					set:html={JSON.stringify(schemaGraph.length === 1 ? schemaGraph[0] : { "@context": "https://schema.org", "@graph": schemaGraph })}
				/>
			)
		}
		<style is:global>
			@import url("https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Space+Grotesk:wght@400;500;700&display=swap");

			:root {
				--color-ink: #0f1720;
				--color-on-dark: #ffffff;
				--color-muted: #52606d;
				--color-paper: #f7f4ec;
				--color-panel: rgba(255, 255, 255, 0.74);
				--color-border: rgba(15, 23, 32, 0.12);
				--color-accent: #ef7d42;
				--color-accent-deep: #bc4728;
				--color-accent-soft: rgba(239, 125, 66, 0.12);
				--color-shadow: rgba(15, 23, 32, 0.08);
				--color-button-secondary: rgba(255, 255, 255, 0.58);
				--color-card-panel: rgba(255, 255, 255, 0.82);
				--color-featured-start: #17232e;
				--color-featured-end: #0f1720;
				--color-featured-mark: rgba(255, 255, 255, 0.14);
				--color-featured-muted: rgba(255, 255, 255, 0.72);
				--color-featured-border: rgba(255, 255, 255, 0.28);
				--space-2: 0.5rem;
				--space-3: 0.75rem;
				--space-4: 1rem;
				--space-6: 1.5rem;
				--space-8: 2rem;
				--space-12: 3rem;
				--space-16: 4rem;
				--radius-m: 1.1rem;
				--radius-l: 2rem;
				--shadow-soft: 0 24px 60px var(--color-shadow);
				--content-width: 72rem;
				--project-card-min-height: 26rem;
				--transition-fast: 180ms ease;
				--blur-in-duration: 500ms;
				--blur-in-offset: 20px;
				--blur-in-radius: 20px;
				--color-brand-navy: #0c1b28;
				--color-brand-orange: #ff823b;
				--scene-fog-navy-opacity: 0.1;
				--scene-fog-orange-opacity: 0.12;
				--scene-fog-drift-navy-duration: 64s;
				--scene-fog-drift-orange-duration: 52s;
				--scene-mark-glow-opacity: 0.14;
				--scene-mark-glow-blur: 44px;
				--scene-mark-edge-opacity: 0.1;
				--scene-mark-edge-blur: 1.2px;
				--scene-mark-shift-max: 18px;
				--scene-mark-drift-duration: 40s;
			}

			* {
				box-sizing: border-box;
			}

			html {
				scroll-behavior: smooth;
			}

			body {
				margin: 0;
				font-family: "Space Grotesk", sans-serif;
				color: var(--color-ink);
				background:
					radial-gradient(circle at top left, rgba(239, 125, 66, 0.22), transparent 24rem),
					linear-gradient(180deg, #f3ecda 0%, var(--color-paper) 36%, #fdfbf6 100%);
				min-height: 100vh;
			}

			a {
				color: inherit;
			}

			.page-shell {
				position: relative;
				z-index: 1;
				width: min(calc(100% - 2rem), var(--content-width));
				margin: 0 auto;
			}

			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: var(--space-6) 0 var(--space-8);
				gap: var(--space-4);
			}

			.brand-lockup {
				display: inline-flex;
				align-items: center;
				text-decoration: none;
			}

			.brand-mark {
				width: 2.75rem;
				height: 2.75rem;
				display: block;
				object-fit: contain;
			}

			.site-nav {
				display: flex;
				gap: var(--space-4);
				flex-wrap: wrap;
			}

			.site-nav a {
				text-decoration: none;
				font-size: 0.95rem;
				color: var(--color-muted);
			}

			main {
				padding-bottom: var(--space-16);
			}

			.site-footer {
				display: grid;
				gap: var(--space-4);
				padding: var(--space-12) 0;
				border-top: 1px solid var(--color-border);
				color: var(--color-muted);
				font-size: 0.95rem;
			}

			.site-footer-main {
				display: flex;
				align-items: baseline;
				justify-content: space-between;
				gap: var(--space-4);
				flex-wrap: wrap;
			}

			.site-footer-tagline {
				margin: 0;
				color: var(--color-ink);
				font-weight: 700;
			}

			.site-footer-contact {
				margin: 0;
			}

			.site-footer-nav {
				display: flex;
				gap: var(--space-4);
				flex-wrap: wrap;
			}

			.site-footer-nav a {
				text-decoration: none;
			}

			.site-footer-nav a:hover,
			.site-footer-contact a:hover {
				color: var(--color-ink);
			}

			.site-footer-copyright {
				margin: 0;
				font-size: 0.85rem;
			}

			.skip-link {
				position: absolute;
				left: 1rem;
				top: -4rem;
				z-index: 10;
				padding: 0.75rem 1rem;
				border-radius: 999px;
				background: var(--color-ink);
				color: var(--color-on-dark);
				text-decoration: none;
			}

			.skip-link:focus {
				top: 1rem;
			}

			.legal-prose {
				background: var(--color-panel);
				backdrop-filter: blur(14px);
				border: 1px solid var(--color-border);
				border-radius: var(--radius-l);
				box-shadow: var(--shadow-soft);
				padding: clamp(1.5rem, 2vw, 2.5rem);
			}

			.legal-prose h1,
			.legal-prose h2,
			.legal-prose h3 {
				font-family: "Instrument Serif", serif;
				font-weight: 400;
				line-height: 1;
				letter-spacing: -0.03em;
				margin: 0 0 var(--space-4);
			}

			.legal-prose h1 {
				font-size: clamp(2.75rem, 6vw, 4.75rem);
				margin-bottom: var(--space-6);
			}

			.legal-prose h2 {
				font-size: clamp(1.75rem, 3vw, 2.5rem);
				margin-top: var(--space-8);
			}

			.legal-prose p,
			.legal-prose li {
				color: var(--color-muted);
				font-size: 1rem;
				line-height: 1.7;
			}

			.legal-prose ul {
				padding-left: 1.25rem;
			}

			.eyebrow {
				font-size: 0.8rem;
				font-weight: 700;
				letter-spacing: 0.14em;
				text-transform: uppercase;
				color: var(--color-accent-deep);
				margin-bottom: var(--space-4);
			}

			.button {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				border: 0;
				border-radius: 999px;
				padding: 0.9rem 1.25rem;
				font: inherit;
				font-weight: 700;
				letter-spacing: 0.02em;
				text-decoration: none;
				cursor: pointer;
				transition:
					transform var(--transition-fast),
					background-color var(--transition-fast),
					color var(--transition-fast);
			}

			.button:hover {
				transform: translateY(-2px);
			}

			.button-primary {
				background: var(--color-ink);
				color: var(--color-on-dark);
			}

			.button-secondary {
				background: var(--color-button-secondary);
				border: 1px solid var(--color-border);
			}

			@media (max-width: 720px) {
				.site-header,
				.site-footer-main {
					align-items: flex-start;
					flex-direction: column;
				}
			}
		</style>
	</head>
	<body>
		<BackgroundScene />
		<div class="page-shell">
			<a class="skip-link" href="#main-content">Skip to content</a>
			<header class="site-header">
				<a class="brand-lockup" href="/" aria-label="Eclectic Byte home">
					<img class="brand-mark" src={siteConfig.brandMarkPath} alt="" width="44" height="44" />
				</a>
				<nav class="site-nav" aria-label="Primary">
					<a href={vatLoomConfig.path}>VatLoom</a>
					<a href="/#projects">Projects</a>
					<a href="/blog/">Blog</a>
				</nav>
			</header>
			<main id="main-content">
				<slot />
			</main>
			<footer class="site-footer">
				<div class="site-footer-main">
					<p class="site-footer-tagline">{siteConfig.siteTagline}</p>
					<p class="site-footer-contact">
						{siteConfig.founder.name} · <a href={`mailto:${siteConfig.founder.email}`}>{siteConfig.founder.email}</a>
					</p>
				</div>
				<nav class="site-footer-nav" aria-label="Footer">
					<a href={vatLoomConfig.path}>VatLoom</a>
					<a href={habitoroConfig.websiteUrl}>Habitoro</a>
					<a href="/#projects">Projects</a>
					<a href="/blog/">Blog</a>
					<a href="/legal/">Legal</a>
					<a href={siteConfig.privacyPath}>Privacy</a>
				</nav>
				<p class="site-footer-copyright">© {new Date().getFullYear()} {siteConfig.siteName}</p>
			</footer>
		</div>
	</body>
</html>
